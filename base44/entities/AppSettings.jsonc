{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "singleton_key": {
      "type": "string",
      "default": "global",
      "description": "Always 'global' \u2014 there is only one settings record."
    },
    "provider": {
      "type": "string",
      "enum": [
        "browserbase",
        "browserless",
        "scrapingbee"
      ],
      "default": "scrapingbee",
      "description": "Browser automation provider"
    },
    "timeout_ms": {
      "type": "number",
      "default": 60000,
      "description": "Max session duration (ms)"
    },
    "viewport_width": {
      "type": "number",
      "default": 1920,
      "description": "Browser viewport width"
    },
    "viewport_height": {
      "type": "number",
      "default": 1080,
      "description": "Browser viewport height"
    },
    "browserbase_region": {
      "type": "string",
      "enum": [
        "us-west-2",
        "us-east-1",
        "eu-central-1",
        "ap-southeast-1"
      ],
      "default": "us-west-2",
      "description": "Browserbase session region"
    },
    "browserbase_keep_alive": {
      "type": "boolean",
      "default": false,
      "description": "Keep Browserbase session alive after disconnection"
    },
    "browserless_endpoint": {
      "type": "string",
      "default": "production-sfo",
      "description": "Browserless endpoint (production-sfo, etc.)"
    },
    "browserless_stealth_proxy": {
      "type": "boolean",
      "default": true,
      "description": "Enable stealth proxy mode for Browserless"
    },
    "capture_video": {
      "type": "boolean",
      "default": true,
      "description": "Capture video recording of sessions"
    },
    "capture_screenshots": {
      "type": "boolean",
      "default": false,
      "description": "Capture screenshots during session"
    },
    "proxy_mode": {
      "type": "string",
      "enum": [
        "classic",
        "premium",
        "stealth",
        "external",
        "pool",
        "none"
      ],
      "default": "premium",
      "description": "ScrapingBee proxy tier"
    },
    "country_code": {
      "type": "string",
      "default": "au",
      "description": "ISO 3166-1 alpha-2 country code (requires premium/stealth on ScrapingBee)"
    },
    "external_proxy_id": {
      "type": "string",
      "description": "ID of Proxy entity for external proxy mode"
    },
    "proxy_pool_id": {
      "type": "string",
      "description": "ID of ProxyPool entity for pooled external proxy mode"
    },
    "block_ads": {
      "type": "boolean",
      "default": true,
      "description": "Block ads (ScrapingBee)"
    },
    "block_resources": {
      "type": "boolean",
      "default": true,
      "description": "Block images/CSS (ScrapingBee)"
    },
    "wait_after_load_ms": {
      "type": "number",
      "default": 0,
      "description": "Wait after page load (ms)"
    },
    "user_agent": {
      "type": "string",
      "description": "Optional custom user agent"
    },
    "default_login_strategy": {
      "type": "string",
      "enum": [
        "single",
        "multi_password",
        "all_passwords"
      ],
      "default": "multi_password",
      "description": "Default password testing strategy"
    },
    "recording_retention_days": {
      "type": "number",
      "default": 30,
      "description": "Days to retain video recordings"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}