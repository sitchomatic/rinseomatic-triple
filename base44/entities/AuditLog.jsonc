{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "function_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "running"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "string"
    },
    "execution_ms": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "function_name",
    "status"
  ]
}